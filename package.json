{
  "name": "payroll-ledger-api",
  "version": "1.0.0",
  "description": "Double-entry payout ledger API with idempotency keys, concurrency-safe balances and a PostgreSQL-backed payout queue.",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "worker": "tsx src/worker.ts",
    "migrate": "tsx src/migrate.ts",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "load": "tsx scripts/load-test.ts"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "autocannon": "^9.0.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "5.8"
  }
}
